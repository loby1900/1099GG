[node name="HeadlightL" type="SpotLight3D" parent="Lights"]
transform = Transform3D(-1, 0, 0, 0, 0.990268, 0.139173, 0, 0.139173, -0.990268, -0.32, 0.4, 0.92)
light_color = Color(1.0, 0.96, 0.88, 1.0)
light_energy = 4.0
# Checked with a zeroed-energy A/B render on the night map: the warm glow
# visible past the rear of the car from the chase camera is the headlight's
# own forward beam lighting the road ahead, peeking out below the car's
# silhouette from this elevated viewing angle -- not a shadow/occlusion bug
# (toggling shadow_enabled alone didn't change it). Left on regardless since
# it's cheap here (only this one car ever has active lights) and still
# avoids any odd self-shadowing on the car's own body from a side/static cam.
shadow_enabled = true
spot_range = 16.0
spot_angle = 35.0
spot_angle_attenuation = 1.6

