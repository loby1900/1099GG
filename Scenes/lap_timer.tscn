[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://Scripts/Checkpoints/LapTimer.gd" id="1"]

[node name="LapTimer" type="Node3D"]
script = ExtResource("1")

[node name="LapTimes" type="CanvasLayer" parent="."]

[node name="MarginContainer" type="MarginContainer" parent="LapTimes"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 24
theme_override_constants/margin_top = 20

[node name="VBoxContainer" type="VBoxContainer" parent="LapTimes/MarginContainer"]
layout_mode = 2
size_flags_horizontal = 0
size_flags_vertical = 0
theme_override_constants/separation = 4

[node name="Last" type="Label" parent="LapTimes/MarginContainer/VBoxContainer"]
layout_mode = 2
theme_override_font_sizes/font_size = 22
text = "Best Lap: --"

[node name="Lap" type="Label" parent="LapTimes/MarginContainer/VBoxContainer"]
layout_mode = 2
theme_override_font_sizes/font_size = 22
text = "Lap Completed: --"

[node name="Sector1" type="Label" parent="LapTimes/MarginContainer/VBoxContainer"]
layout_mode = 2
theme_override_font_sizes/font_size = 18
text = "Sector 1 Time: --"

[node name="Sector2" type="Label" parent="LapTimes/MarginContainer/VBoxContainer"]
layout_mode = 2
theme_override_font_sizes/font_size = 18
text = "Sector 2 Time: --"

[node name="Sector3" type="Label" parent="LapTimes/MarginContainer/VBoxContainer"]
layout_mode = 2
theme_override_font_sizes/font_size = 18
text = "Sector 3 Time: --"
