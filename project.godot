; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Apex Drift"
config/description="Arcade drift racing built in Godot 4.7, with full touch controls for mobile."
config/version="1.0.0"
run/main_scene="res://Scenes/MainMenu3D.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://Images/logo.png"
run/max_fps=240
boot_splash/bg_color=Color(0.0352941, 0.0509804, 0.101961, 1)
boot_splash/image="res://Images/Splash.png"
boot_splash/fullsize=true
boot_splash/use_filter=true
boot_splash/minimum_display_time=1200

[autoload]

GameData="*res://Scripts/GameData.gd"
TouchInputRouter="*res://Scripts/TouchInputRouter.gd"
MusicController="*res://Scenes/music_controller.tscn"
LoadingScreen="*res://Scripts/LoadingScreen.gd"
BestLapManager="*res://Scripts/BestLapManager.gd"

[audio]

buses/default_bus_layout="res://default_bus_layout.tres"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=3
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=0
window/handheld/orientation="sensor_landscape"
window/energy_saving/keep_screen_on=true

